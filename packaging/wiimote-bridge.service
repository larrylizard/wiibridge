[Unit]
Description=Wii Remote (clone-compatible) Bluetooth bridge
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
# Adjust this path to wherever you cloned the repo.
ExecStart=/usr/bin/python3 /opt/wii_control/wiimote_bridge.py
Restart=on-failure
RestartSec=3
# Run setup-permissions.sh once first, then set this to your own user --
# no root needed (see that script for what it grants and why).
User=CHANGE_ME

[Install]
WantedBy=multi-user.target
